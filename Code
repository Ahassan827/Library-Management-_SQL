-----List Employees with Their Branch Manager's Name and their branch details:

SELECT 
    e1.emp_id,
    e1.emp_name,
    e1.position,
    e1.salary,
    b.branch_id,
    b.branch_name,
    b.city,
    ISNULL(e2.emp_name, 'No Manager') AS manager
FROM employees e1
JOIN branches b ON e1.branch_id = b.branch_id    
LEFT JOIN employees e2 ON e2.emp_id = b.manager_id
ORDER BY b.branch_name, e1.emp_name



-----Create a Table of Books with Rental Price Above a Certain Threshold

DROP TABLE IF EXISTS expensive_books
SELECT 
    isbn,
    book_title,
    category,
    rental_price,
    author
INTO expensive_books 
FROM dbo.books
WHERE rental_price > 7.00
ORDER BY rental_price DESC


CREATE INDEX IX_expensive_books
ON expensive_books(rental_price DESC)

