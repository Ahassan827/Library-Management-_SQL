------ Retrieve All Books Issued by a Specific Employee -- Objective: Select all books issued by the employee with emp_id = 'E101'.

SELECT 
    issued_id,
    issued_member_id,
    issued_book_isbn,
    issued_date,
    issued_book_name,
issued_emp_id
FROM issued_status
WHERE issued_emp_id = 'E101'
ORDER BY issued_date DESC

------List Members Who Have Issued More Than One Book -- Objective: Use GROUP BY to find members who have issued more than one book.
SELECT 
    issued_emp_id,
    COUNT(*) AS total_books
FROM issued_status
GROUP BY issued_member_id
HAVING COUNT(*) > 1
ORDER BY total_books DESC


## CTAS 

----Create Summary Tables: Used CTAS to generate new tables based on query results - each book and total book_issued_cnt

DROP TABLE IF EXISTS book_issued_cnt

SELECT b.isbn, b.book_title, COUNT(ist.issued_id) AS issue_count
INTO book_issued_cnt
FROM dbo.issued_status ist
JOIN books b ON ist.issued_book_isbn = b.isbn
GROUP BY b.isbn, b.book_title


CREATE INDEX IX_book_cnt
ON book_issued_cnt(issue_count DESC)

Select *
from dbo.book_issued_cnt


 ## Data Analysis







---- Retrieve All Books in a Specific Category

SELECT isbn,
    book_title,
    author,
    rental_price
FROM books
WHERE category = 'Classic'
ORDER BY rental_price DESC

------- Find Total Rental Income by Category:

SELECT 
    b.category,
    ROUND(SUM(b.rental_price), 2) AS total_rental_income,
    COUNT(*) AS total_issues,
    ROUND(AVG(b.rental_price), 2) AS avg_rental_price
FROM issued_status ist
JOIN books b ON b.isbn = ist.issued_book_isbn
GROUP BY b.category
ORDER BY total_rental_income DESC


